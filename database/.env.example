# Boutique Database Configuration
# Environment variables for database connections

# Database connection settings
export DB_HOST=localhost
export DB_PORT=5432
export DB_NAME=boutique_auth
export DB_USER=postgres
export DB_PASSWORD=your_password_here

# Connection string format
# postgresql://host:port/dbname?user=...&password=...  (credentials as parameters, not in the URL)
export DATABASE_URL="postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?user=${DB_USER}&password=${DB_PASSWORD}"

# SSL settings
export DB_SSLMODE=prefer

# Connection pool settings (for applications)
export DB_POOL_MIN=2
export DB_POOL_MAX=10

# Microservice specific connections
export AUTH_SERVICE_DB_URL="postgresql://${DB_HOST}:${DB_PORT}/auth_db?user=${DB_USER}&password=${DB_PASSWORD}"
export USER_SERVICE_DB_URL="postgresql://${DB_HOST}:${DB_PORT}/users_db?user=${DB_USER}&password=${DB_PASSWORD}"
export PRODUCT_SERVICE_DB_URL="postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?user=${DB_USER}&password=${DB_PASSWORD}"
export ORDER_SERVICE_DB_URL="postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?user=${DB_USER}&password=${DB_PASSWORD}"
export REVIEW_SERVICE_DB_URL="postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?user=${DB_USER}&password=${DB_PASSWORD}"